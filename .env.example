# Copia este archivo como .env y completa tu API key. Nunca subas .env al repo.

# Groq: https://console.groq.com/ > API Keys (empieza con "gsk_")
GROQ_API_KEY=""

# Modelo del RAG (respuestas con citas e interpretación de líneas dudosas de WhatsApp)
GROQ_MODEL="openai/gpt-oss-120b"
# Modelo de los agentes Analista y Correos (estable con tool calling; el 120b
# inventó un nombre de herramienta en las pruebas, ver docs/arquitectura_agente.md)
GROQ_MODEL_TOOLS="openai/gpt-oss-20b"

# Embeddings locales (sin API key; la primera vez descarga ~470 MB)
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Observabilidad (EP3). Déjalo en false hasta tener LANGSMITH_API_KEY.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="pampasur-agente"

# Correos (EP2). outbox: solo guarda los .eml en outbox/ (no sale nada).
# gmail: los envía con la API de Gmail (antes: uv run python -m scripts.autenticar_gmail)
MODO_CORREO="outbox"
# Los contactos del caso son ficticios (@pampasur.example): en modo gmail
# todos los correos llegan a esta dirección, con el destinatario original en el asunto.
CORREO_REDIRIGIR_A=""
